# Copy to .env before starting the stack:  cp .env.example .env
#
# Defaults for every setting live in appsettings.json (src/OrderIngestion.Worker and
# simulate/OrderIngestion.MockApi). This file only holds what must differ inside Docker,
# plus secrets. Names are .NET config keys: Section__Key overrides "Section": { "Key": ... }.
#
# The values below are for the local/CI test stack (mock API + Mailpit). On a server, .env
# points the worker at the real order API and the real mail server instead.

# --- Required in Docker: where the other containers are --------------------
OrderApi__BaseUrl=http://mock-api:8080
Alerts__SmtpHost=mailpit

# --- A real mail server instead of Mailpit (uncomment and fill in) ---------
# Alerts__SmtpHost=smtp.example.com
# Alerts__SmtpPort=465
# Alerts__SmtpUsername=
# Alerts__SmtpPassword=
# Alerts__From=
# Alerts__To=

# --- Azure Application Insights (scaffold only; leave unset to keep it off) -
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=https://...

# --- Any other setting can be overridden the same way, for example ---------
# Ingestion__IntervalMinutes=1
# Log__Level=debug
# Mock__Scenario=orders-drift
