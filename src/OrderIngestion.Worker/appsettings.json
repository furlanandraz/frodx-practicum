{
  "Ingestion": {
    "IntervalMinutes": 15,
    "CursorOverlapSeconds": 60
  },
  "OrderApi": {
    "BaseUrl": "http://localhost:8080",
    "OrdersPath": "/orders",
    "TimeoutSeconds": 10
  },
  "Database": {
    "FilePath": "data/orders.db"
  },
  "Alerts": {
    "Enabled": true,
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "From": "app@example.com",
    "To": "user@example.com",
    "ThrottleMinutes": 60
  },
  "Log": {
    "Level": "info",
    "Directory": "logs"
  }
}
